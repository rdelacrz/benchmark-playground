{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "paths": {
      "@benchmarkers/*": ["./src/benchmarkers/*"],
      "@operations/*": ["./src/operations/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "types": ["node"],
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "removeComments": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
